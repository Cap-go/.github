{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for Cap-go Capacitor and Cordova plugins. Use with extends github>Cap-go/.github:renovate-config",
  "extends": [
    "config:base",
    "schedule:earlyMondays"
  ],
  "dependencyDashboard": false,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "platformAutomerge": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null,
      "description": "Lock file maintenance has no release timestamp; do not delay it"
    },
    {
      "matchPackagePatterns": [
        "^com\\.google\\..*"
      ],
      "matchCurrentVersion": "/^.*-android$/",
      "allowedVersions": "/^.*-android$/"
    },
    {
      "matchPackagePatterns": [
        "^com\\.android\\.tools\\.build\\:gradle$"
      ],
      "matchManagers": [
        "gradle"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "swift"
      ],
      "matchPackagePatterns": [
        "^https://github.com/ionic-team/capacitor-swift-pm\\.git$",
        "^ionic-team/capacitor-swift-pm$",
        "^capacitor-swift-pm$"
      ],
      "allowedVersions": "8.0.0",
      "enabled": false
    },
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "matchPackageNames": [
        "@capacitor/core"
      ],
      "enabled": false,
      "description": "Peer @capacitor/core ranges move by hand with each Capacitor major migration, never via Renovate"
    },
    {
      "matchPackageNames": [
        "androidx.core:core"
      ],
      "matchManagers": [
        "gradle"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "enabled": false,
      "description": "Cap-go plugins follow the official Capacitor Android toolchain. The Gradle wrapper moves by hand with Capacitor, never via Renovate"
    },
    {
      "matchPackageNames": [
        "/^com\\.android\\.tools\\.build:gradle$/",
        "/^com\\.android\\.(library|application)/",
        "/^org\\.jetbrains\\.kotlin[:.]/"
      ],
      "enabled": false,
      "description": "Android Gradle plugin and Kotlin follow the official Capacitor Android toolchain, never via Renovate"
    },
    {
      "matchPackageNames": [
        "androidx.core:core-ktx"
      ],
      "matchManagers": [
        "gradle"
      ],
      "allowedVersions": "<1.19.0",
      "description": "core-ktx 1.19 needs compileSdk 37 and AGP 9.1; lift when plugins move to AGP 9"
    },
    {
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7",
      "description": "TypeScript 7 not supported yet"
    }
  ]
}
